# ---------------------------------------------------------------------------
# Copier ce fichier en .env (racine) et/ou dans apps/api/.env, apps/web/.env.local
# Ne jamais committer de vrais secrets.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace
# 5433 côté hôte: évite tout conflit avec une instance PostgreSQL déjà installée
# nativement sur la machine (souvent déjà présente sur 5432 sous Windows).
POSTGRES_PORT=5433
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5433/marketplace?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3 compatible, dev local) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marketplace-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# En production (Cloudflare R2), renseigner les valeurs R2 et mettre S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev   # optionnel: URL publique si différente de S3_ENDPOINT+S3_BUCKET

# --- API (NestJS) ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NODE_ENV=development

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMS_PROVIDER=console
# Plus tard: twilio, nexah, etc.

PLATFORM_COMMISSION_PERCENT=8
ORDER_AUTO_RELEASE_DAYS=3

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

SENTRY_DSN=

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# --- Production uniquement (docker-compose.prod.yml + nginx) ---
# API_DOMAIN=api.votredomaine.com
# WEB_DOMAIN=www.votredomaine.com
